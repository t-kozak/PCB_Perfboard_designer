    (comp (ref "C8") (value "100nF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "CH3 CLK debounce (104)")))
    (comp (ref "R12") (value "220") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH3 gate resistor, U2 1Q -> Q3 gate")))
    (comp (ref "R13") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH3 gate pull-down")))
    (comp (ref "Q3") (value "IRLZ44N") (footprint "Perfboard:mosfet-flat")
      (property (name "channel") (value "N-channel"))
      (property (name "perfboard:note") (value "CH3 low-side switch (IRFZ44N also fine). Tab = drain = OUT3-: keep tabs apart, no shared heatsink.")))
    (comp (ref "F3") (value "3A") (footprint "Perfboard:polyfuse")
      (property (name "perfboard:note") (value "CH3 output fuse on +")))
    (comp (ref "R14") (value "2.2k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH3 LED resistor (2k is fine)")))
    (comp (ref "D4") (value "LED (Green)") (footprint "Perfboard:led-green")
      (property (name "size") (value "5mm"))
      (property (name "perfboard:note") (value "CH3 on indicator")))
    (comp (ref "J4") (value "Pin Header 1x2") (footprint "Perfboard:pin-header-1x2")
      (property (name "function") (value "CH3 12V out"))
      (property (name "perfboard:note") (value "Pin 1 = +12V (fused), pin 2 = switched negative. Load current - thick trails.")))
    (comp (ref "SW4") (value "Push Button") (footprint "Perfboard:push-button")
      (property (name "perfboard:note") (value "CH4 toggle. Wired on diagonal legs 1 and 3, so it works whichever leg pairs are joined inside.")))
    (comp (ref "R15") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH4 CLK pull-down")))
    (comp (ref "C9") (value "100nF") (footprint "Perfboard:cap-ceramic")
