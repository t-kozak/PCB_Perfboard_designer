(export (version "E")
  (design
    (source "12V 1-to-4 switched DC splitter - single 4-channel board")
    (date "2026-09-25"))
  (components
    (comp (ref "J1") (value "Pin Header 1x2") (footprint "Perfboard:pin-header-1x2")
      (property (name "function") (value "12V power in"))
      (property (name "perfboard:note") (value "Pin 1 = +12V, pin 2 = GND. Carries the full load current of all 4 outputs - use thick wire/solder trails on +12V and GND.")))
    (comp (ref "C1") (value "100µF") (footprint "Perfboard:cap-electrolytic")
      (property (name "voltage") (value "25V"))
      (property (name "perfboard:note") (value "Input bulk cap, next to J1")))
    (comp (ref "R1") (value "100") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "Logic supply filter, +12V -> VL")))
    (comp (ref "C2") (value "100µF") (footprint "Perfboard:cap-electrolytic")
      (property (name "voltage") (value "25V"))
      (property (name "perfboard:note") (value "Logic supply filter cap on VL")))
    (comp (ref "C3") (value "1µF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "Power-on reset, VL -> RST (105)")))
    (comp (ref "R2") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "Power-on reset pull-down, RST -> GND")))
    (comp (ref "D1") (value "1N4007") (footprint "Perfboard:diode")
      (property (name "diodeType") (value "Rectifier"))
      (property (name "perfboard:note") (value "Reset clamp: band (K) to RST, anode to GND")))
    (comp (ref "U1") (value "CD4013BE") (footprint "Perfboard:cd4013be")
      (property (name "perfboard:note") (value "Channels 1 (FF1) and 2 (FF2)")))
    (comp (ref "U2") (value "CD4013BE") (footprint "Perfboard:cd4013be")
      (property (name "perfboard:note") (value "Channels 3 (FF1) and 4 (FF2)")))
    (comp (ref "C4") (value "100nF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "U1 decoupling, as close to pins 14/7 as possible (104)")))
    (comp (ref "C5") (value "100nF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "U2 decoupling, as close to pins 14/7 as possible (104)")))
    (comp (ref "SW1") (value "Push Button") (footprint "Perfboard:push-button")
      (property (name "perfboard:note") (value "CH1 toggle. Wired on diagonal legs 1 and 3, so it works whichever leg pairs are joined inside.")))
    (comp (ref "R3") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH1 CLK pull-down")))
    (comp (ref "C6") (value "100nF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "CH1 CLK debounce (104)")))
    (comp (ref "R4") (value "220") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH1 gate resistor, U1 1Q -> Q1 gate")))
    (comp (ref "R5") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH1 gate pull-down")))
    (comp (ref "Q1") (value "IRLZ44N") (footprint "Perfboard:mosfet-flat")
      (property (name "channel") (value "N-channel"))
      (property (name "perfboard:note") (value "CH1 low-side switch (IRFZ44N also fine). Tab = drain = OUT1-: keep tabs apart, no shared heatsink.")))
    (comp (ref "F1") (value "3A") (footprint "Perfboard:polyfuse")
      (property (name "perfboard:note") (value "CH1 output fuse on +")))
    (comp (ref "R6") (value "2.2k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH1 LED resistor (2k is fine)")))
    (comp (ref "D2") (value "LED (Green)") (footprint "Perfboard:led-green")
      (property (name "size") (value "5mm"))
      (property (name "perfboard:note") (value "CH1 on indicator")))
    (comp (ref "J2") (value "Pin Header 1x2") (footprint "Perfboard:pin-header-1x2")
      (property (name "function") (value "CH1 12V out"))
      (property (name "perfboard:note") (value "Pin 1 = +12V (fused), pin 2 = switched negative. Load current - thick trails.")))
    (comp (ref "SW2") (value "Push Button") (footprint "Perfboard:push-button")
      (property (name "perfboard:note") (value "CH2 toggle. Wired on diagonal legs 1 and 3, so it works whichever leg pairs are joined inside.")))
    (comp (ref "R7") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH2 CLK pull-down")))
    (comp (ref "C7") (value "100nF") (footprint "Perfboard:cap-ceramic")
      (property (name "perfboard:note") (value "CH2 CLK debounce (104)")))
    (comp (ref "R8") (value "220") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH2 gate resistor, U1 2Q -> Q2 gate")))
    (comp (ref "R9") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH2 gate pull-down")))
    (comp (ref "Q2") (value "IRLZ44N") (footprint "Perfboard:mosfet-flat")
      (property (name "channel") (value "N-channel"))
      (property (name "perfboard:note") (value "CH2 low-side switch (IRFZ44N also fine). Tab = drain = OUT2-: keep tabs apart, no shared heatsink.")))
    (comp (ref "F2") (value "3A") (footprint "Perfboard:polyfuse")
      (property (name "perfboard:note") (value "CH2 output fuse on +")))
    (comp (ref "R10") (value "2.2k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
      (property (name "perfboard:note") (value "CH2 LED resistor (2k is fine)")))
    (comp (ref "D3") (value "LED (Green)") (footprint "Perfboard:led-green")
      (property (name "size") (value "5mm"))
      (property (name "perfboard:note") (value "CH2 on indicator")))
    (comp (ref "J3") (value "Pin Header 1x2") (footprint "Perfboard:pin-header-1x2")
      (property (name "function") (value "CH2 12V out"))
      (property (name "perfboard:note") (value "Pin 1 = +12V (fused), pin 2 = switched negative. Load current - thick trails.")))
    (comp (ref "SW3") (value "Push Button") (footprint "Perfboard:push-button")
      (property (name "perfboard:note") (value "CH3 toggle. Wired on diagonal legs 1 and 3, so it works whichever leg pairs are joined inside.")))
    (comp (ref "R11") (value "100k") (footprint "Perfboard:resistor")
      (property (name "power") (value "0.25W"))
