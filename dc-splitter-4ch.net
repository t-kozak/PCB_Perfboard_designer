      (node (ref "R7") (pin "2"))
      (node (ref "C7") (pin "2"))
      (node (ref "R9") (pin "2"))
      (node (ref "Q2") (pin "3") (pinfunction "S"))
      (node (ref "R11") (pin "2"))
      (node (ref "C8") (pin "2"))
      (node (ref "R13") (pin "2"))
      (node (ref "Q3") (pin "3") (pinfunction "S"))
      (node (ref "R15") (pin "2"))
      (node (ref "C9") (pin "2"))
      (node (ref "R17") (pin "2"))
      (node (ref "Q4") (pin "3") (pinfunction "S")))
    (net (code "3") (name "VL")
