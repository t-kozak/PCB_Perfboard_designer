{
  "name": "pcb-perfboard-designer",
  "version": "2.0.0",
  "private": true,
  "description": "Browser-based CAD tool for laying out electronic circuits on a virtual perfboard grid.",
  "homepage": "https://maurerkrisztian.github.io/PCB_Perfboard_designer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maurerkrisztian/PCB_Perfboard_designer.git"
  },
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predeploy": "pnpm run build",
    "deploy": "pnpm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
